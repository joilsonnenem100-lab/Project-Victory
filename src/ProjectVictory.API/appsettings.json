{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ProjectVictory": "Data Source=projectvictory.db"
  },
  "Jwt": {
    "Issuer": "ProjectVictory.API",
    "Audience": "ProjectVictory.Client"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Progression": {
    "ExperienceRate": 1.0
  },
  "Admin": {
    "Accounts": []
  },
  "Supplies": {
    "StarterKit": {
      "HealthPotion": 30,
      "StrongHealthPotion": 10,
      "GreatHealthPotion": 3,
      "ManaPotion": 20,
      "StrongManaPotion": 5,
      "GreatManaPotion": 2
    }
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "GameSession": {
    "DisconnectTimeoutSeconds": 60,
    "ReturnDelaySeconds": 10,
    "SweepIntervalSeconds": 5
  },
  "LevelTitles": [
    { "Tier": 0, "Label": "Novice", "MinimumLevel": 1 },
    { "Tier": 1, "Label": "Ascension 1", "MinimumLevel": 500 },
    { "Tier": 2, "Label": "Ascension 2", "MinimumLevel": 1000 },
    { "Tier": 3, "Label": "Ascension 3", "MinimumLevel": 1500 },
    { "Tier": 4, "Label": "Ascension 4", "MinimumLevel": 2000 },
    { "Tier": 5, "Label": "Legend", "MinimumLevel": 2500 }
  ]
}
